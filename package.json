{
  "name": "notifykit-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "build:core": "bun run --filter @signal_stack/notifykit-core build",
    "build:cli": "bun run --filter @signal_stack/notifykit build",
    "build:local-mcp": "bun run --filter @signal_stack/notifykit-mcp build",
    "dev:cli": "bun run packages/cli/src/index.ts",
    "dev:local-mcp": "bun run packages/local-mcp/src/index.ts",
    "dev:remote-mcp": "bun run apps/remote-mcp/src/index.ts",
    "release:pack:core": "bun run --filter @signal_stack/notifykit-core pack:dry",
    "release:pack:cli": "bun run --filter @signal_stack/notifykit pack:dry",
    "release:pack:local-mcp": "bun run --filter @signal_stack/notifykit-mcp pack:dry",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
